    { "component": "Alert", "kinds": ["callout"], "archetypes": ["overview", "operations", "intake"], "jobs": ["explain", "alert"] },
    { "component": "FormCard", "kinds": ["form"], "archetypes": ["intake"], "requires": ["create"], "jobs": ["capture"] },
