    { "component": "KanbanBoard", "kinds": ["queue"], "archetypes": ["queue", "operations"], "requires": ["workflow", "mover"], "jobs": ["move", "prioritize"] },
    { "component": "WipStrip", "kinds": ["queue", "progress"], "archetypes": ["operations", "overview"], "requires": ["workflow"], "jobs": ["monitor", "sequence"] },
    { "component": "Table", "kinds": ["table"], "archetypes": ["register", "queue", "analytics", "operations"], "jobs": ["inspect", "compare"] },
    { "component": "HBars", "kinds": ["bar-chart"], "archetypes": ["overview", "analytics", "operations"], "requires": ["categorical"], "jobs": ["rank", "compare"] },
    { "component": "BarChart", "kinds": ["bar-chart"], "archetypes": ["overview", "analytics"], "requires": ["categorical"], "jobs": ["compare"] },
    { "component": "FunnelChart", "kinds": ["bar-chart"], "archetypes": ["overview", "analytics", "operations"], "requires": ["workflow"], "jobs": ["sequence", "analyze"] },
    { "component": "StackedBar", "kinds": ["bar-chart"], "archetypes": ["analytics", "operations"], "requires": ["categorical", "workflow"], "jobs": ["compare", "analyze"] },
    { "component": "Donut", "kinds": ["donut-chart"], "archetypes": ["overview", "analytics"], "requires": ["categorical"], "jobs": ["distribute", "summarize"] },
    { "component": "SegmentBar", "kinds": ["donut-chart", "progress"], "archetypes": ["overview", "analytics"], "requires": ["categorical"], "jobs": ["distribute", "monitor"] },
    { "component": "LineChart", "kinds": ["trend-chart"], "archetypes": ["overview", "analytics"], "requires": ["date"], "jobs": ["trend", "forecast"] },
    { "component": "Heatmap", "kinds": ["trend-chart"], "archetypes": ["analytics", "operations"], "requires": ["date"], "jobs": ["trend", "detect-pattern"] },
