    { "component": "GanttChart", "kinds": ["timeline"], "archetypes": ["register", "analytics", "operations"], "requires": ["dateRange"], "jobs": ["schedule", "compare-overlap", "review-approval-risk"] },
    { "component": "Calendar", "kinds": ["timeline"], "archetypes": ["intake", "operations"], "requires": ["date"], "jobs": ["schedule"] },
    { "component": "Stepper", "kinds": ["timeline", "progress"], "archetypes": ["intake", "operations"], "requires": ["workflow"], "jobs": ["sequence", "guide"] },
    { "component": "Accordion", "kinds": ["table"], "archetypes": ["register", "intake"], "requires": ["categorical"], "jobs": ["inspect", "organize"] }
