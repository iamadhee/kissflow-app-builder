            "flowType": "Case",
            "flowId": "Projects_A00"
          },
          "variant": "gradient",
          "tone": "indigo",
          "props": {
            "label": "Sites in pipeline",
            "agg": "count",
            "format": "number",
            "countUp": true,
            "gradient": true,
