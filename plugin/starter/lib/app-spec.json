        },
        {
          "id": "ss_kanban",
          "type": "kanban",
          "binding": {
            "flowType": "Case",
            "flowId": "Projects_A00",
            "groupField": "Untitled_Field",
            "fields": [
              "Summary",
              "Site_Acquistion_ID",
              "Untitled_Field"
            ]
          },
          "variant": "neutral",
          "tone": "neutral",
          "props": {
            "label": "Acquisition pipeline board",
            "cardTitle": "Summary",
            "cardFields": [
              {
                "label": "Site ID",
                "field": "Site_Acquistion_ID"
              }
            ],
            "groupOrder": [
              "Shortlisted",
              "Under Review",
              "Finalized",
              "On Hold",
              "Dropped"
            ],
            "neutralCards": true,
            "noBorders": true,
            "emptyText": "No cases on the board yet",
            "loadingText": "Loading board…"
          }
        },
        {
          "id": "ss_new",
          "type": "form",
          "binding": {
            "flowType": "Case",
            "flowId": "Projects_A00"
          },
          "variant": "modal",
          "props": {
            "label": "New site",
            "newButton": true,
            "hidden": true
          }
        }
