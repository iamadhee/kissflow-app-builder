          "variant": "legend",
          "tone": "indigo",
          "props": {
            "label": "Stage share",
            "agg": "count",
            "center": "Total sites",
            "showLegend": true,
            "colorByIndex": true,
            "emptyText": "No stage data yet",
            "loadingText": "Loading stages…"
