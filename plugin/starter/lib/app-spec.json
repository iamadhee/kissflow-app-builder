        },
        {
          "id": "ss_funnel",
          "type": "funnel",
          "binding": {
            "flowType": "Case",
            "flowId": "Projects_A00",
            "groupField": "Untitled_Field"
          },
          "variant": "glossy",
          "tone": "indigo",
          "props": {
            "label": "Stage funnel",
            "agg": "count",
            "format": "number",
            "order": [
              "Shortlisted",
              "Under Review",
              "Finalized"
