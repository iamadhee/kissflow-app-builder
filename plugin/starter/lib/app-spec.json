            "colorByIndex": true,
            "emptyText": "No stage data yet",
            "loadingText": "Loading stages…"
          }
        },
        {
          "id": "ss_donut",
          "type": "donut",
          "binding": {
            "flowType": "Case",
            "flowId": "Projects_A00",
            "groupField": "Untitled_Field"
